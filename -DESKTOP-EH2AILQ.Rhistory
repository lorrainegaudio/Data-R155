# ⚡ Add a NEW column using case_when()
smaller_movies %>%
dplyr::mutate(
rating_label = dplyr::case_when(
rating >= 4 ~ "Good",
TRUE        ~ "Bad"
)
) -> movies_newcol
set.seed(99)
# Sample 100 movies from the movielens dataset
smaller_movies <- movielens %>%
sample_n(100) %>%
select(title, rating)
head(smaller_movies)
# ⚡ Overwrite numeric rating with an ordered factor via case_when()
movies_overwrite <- smaller_movies %>%
mutate(
rating = factor(
case_when(
rating >= 4 ~ "Good",
TRUE        ~ "Bad"
),
levels = c("Bad", "Good"),
ordered = TRUE
)
)
# ⚡ Add a NEW column using case_when()
smaller_movies %>%
dplyr::mutate(
rating_label = dplyr::case_when(
rating >= 4 ~ "Good",
TRUE        ~ "Bad"
)
) -> movies_newcol
View(movies_newcol)
